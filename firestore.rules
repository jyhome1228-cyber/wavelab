rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'planus253@naver.com';
    }
    function isActiveColumnist() {
      return signedIn()
        && exists(/databases/$(database)/documents/columnistProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/columnistProfiles/$(request.auth.uid)).data.status in ['approved','major'];
    }

    match /users/{uid} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'active';
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
      );
      allow delete: if isAdmin();
    }

    match /visitorVisits/{visitId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['visitorId','date','visitedAt','firstPath','referrer'])
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.size() >= 20
        && request.resource.data.visitorId.size() <= 80
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && visitId == request.resource.data.date + '_' + request.resource.data.visitorId
        && request.resource.data.visitedAt == request.time
        && request.resource.data.firstPath is string
        && request.resource.data.firstPath.size() <= 180
        && request.resource.data.referrer is string
        && request.resource.data.referrer.size() <= 160;
      allow update, delete: if false;
    }

    match /abilities/{uid} {
      allow read: if resource.data.isPublic == true || isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && request.auth.uid == uid && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.content is string
        && request.resource.data.category is string;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /columnistApplications/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.status == 'approved';
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && resource.data.applicantUid == request.auth.uid
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.status == resource.data.status
      );
      allow delete: if isAdmin();
    }

    match /columnistProfiles/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid) || resource.data.status in ['approved','major'];
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'approved'
        && request.resource.data.level == 'columnist'
        && exists(/databases/$(database)/documents/columnistApplications/$(uid))
        && get(/databases/$(database)/documents/columnistApplications/$(uid)).data.status == 'approved';
      allow update, delete: if isAdmin();
    }

    match /columns/{columnId} {
      allow read: if resource.data.status == 'published' || isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);
      allow create: if isActiveColumnist()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status in ['draft','published'];
      allow update: if isAdmin() || (
        isActiveColumnist()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status in ['draft','published']
      );
      allow delete: if isAdmin() || (isActiveColumnist() && resource.data.authorUid == request.auth.uid);
    }
  }
}
