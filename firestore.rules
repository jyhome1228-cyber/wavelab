rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'planus253@naver.com';
    }
    function isActiveColumnist() {
      return signedIn()
        && exists(/databases/$(database)/documents/columnistProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/columnistProfiles/$(request.auth.uid)).data.status in ['approved','major'];
    }

    match /users/{uid} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'active';
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
      );
      allow delete: if isAdmin();
    }

    match /visitorVisits/{visitId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['visitorId','date','visitedAt','firstPath','referrer'])
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.size() >= 20
        && request.resource.data.visitorId.size() <= 80
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && visitId == request.resource.data.date + '_' + request.resource.data.visitorId
        && request.resource.data.visitedAt == request.time
        && request.resource.data.firstPath is string
        && request.resource.data.firstPath.size() <= 180
        && request.resource.data.referrer is string
        && request.resource.data.referrer.size() <= 160;
      allow update, delete: if false;
    }

    match /projectRequests/{requestId} {
      allow list, get: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
          'company','name','phone','email','projectTypes','description',
          'budget','schedule','contactMethod','source','status','createdAt'
        ])
        && request.resource.data.company is string
        && request.resource.data.company.size() <= 120
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 30
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 160
        && request.resource.data.projectTypes is list
        && request.resource.data.projectTypes.size() >= 1
        && request.resource.data.projectTypes.size() <= 8
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 5
        && request.resource.data.description.size() <= 5000
        && request.resource.data.budget is string
        && request.resource.data.budget.size() <= 40
        && request.resource.data.schedule is string
        && request.resource.data.schedule.size() <= 40
        && request.resource.data.contactMethod is string
        && request.resource.data.contactMethod in ['이메일','전화','온라인 미팅']
        && request.resource.data.source == 'aesost.com/request'
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    match /abilities/{uid} {
      allow read: if resource.data.isPublic == true || isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && request.auth.uid == uid && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.content is string
        && request.resource.data.category is string;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /columnistApplications/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.status == 'approved';
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && resource.data.applicantUid == request.auth.uid
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.status == resource.data.status
      );
      allow delete: if isAdmin();
    }

    match /columnistProfiles/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid) || resource.data.status in ['approved','major'];
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'approved'
        && request.resource.data.level == 'columnist'
        && exists(/databases/$(database)/documents/columnistApplications/$(uid))
        && get(/databases/$(database)/documents/columnistApplications/$(uid)).data.status == 'approved';
      allow update, delete: if isAdmin();
    }

    match /columns/{columnId} {
      allow read: if resource.data.status == 'published' || isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);
      allow create: if isActiveColumnist()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status in ['draft','published'];
      allow update: if isAdmin() || (
        isActiveColumnist()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status in ['draft','published']
      );
      allow delete: if isAdmin() || (isActiveColumnist() && resource.data.authorUid == request.auth.uid);
    }
  }
}
